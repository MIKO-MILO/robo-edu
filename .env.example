# ================================================================
# Database
# ================================================================
# Sesuaikan dengan service "mysql" di docker-compose.yml (user: roboedu, db: roboedu)
# Jika menjalankan MySQL via docker-compose, host-nya = mysql
# Jika menjalankan MySQL di host / pakai XAMPP dll, ganti mysql → 127.0.0.1
DATABASE_URL=mysql://roboedu:password_ubah_disini@mysql:3306/roboedu

# Credential untuk service mysql di docker-compose (hanya dibaca docker, bukan app)
DB_PASSWORD=password_ubah_disini
DB_ROOT_PASSWORD=rootpassword_ubah_disini

# ================================================================
# Redis (Queue + BullMQ + Cache)
# ================================================================
# Dipakai oleh:
#   - BullMQ email worker (npm run worker)
#   - Queue producer di webhook route
# Jika via docker-compose, host = redis
# Jika di host, ganti redis → 127.0.0.1
REDIS_URL=redis://redis:6379

# ================================================================
# Worker (BullMQ email worker — src/workers/index.ts)
# ================================================================
# Jalankan worker secara terpisah dari app server:
#   npm run worker
# Worker membutuhkan DATABASE_URL, REDIS_URL, RESEND_API_KEY,
# EMAIL_FROM, EMAIL_FROM_NAME, dan NEXT_PUBLIC_APP_URL (untuk link CTA).

# ================================================================
# MinIO (Object Storage, S3-compatible)
# ================================================================
# Jika via docker-compose, endpoint = minio (hostname internal docker)
# Jika upload dari browser / gunakan signed URL public, bisa ganti ke localhost
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin_ubah_disini
MINIO_SECRET_KEY=miniosecret_ubah_disini
MINIO_BUCKET=roboedu-public

# ================================================================
# Midtrans (Payment Gateway)
# ================================================================
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ================================================================
# Email Service
# ================================================================
# Resend (primary)
RESEND_API_KEY=

# SendGrid (fallback) — opsional, jika mau pakai Resend aja boleh kosong
SENDGRID_API_KEY=

# Alamat email pengirim (harus diverifikasi di Resend / SendGrid)
EMAIL_FROM=no-reply@roboedu.id
EMAIL_FROM_NAME=RoboEdu

# ================================================================
# Auth / Session
# ================================================================
# Generate random string, misal: openssl rand -hex 32
SESSION_SECRET=ganti_dengan_random_string_panjang_minimal_32_char

# ================================================================
# App
# ================================================================
# Base URL aplikasi publik, dipakai untuk generate signed URL, email link, dll
NEXT_PUBLIC_APP_URL=http://localhost

# Internal base URL untuk server-to-server fetch (Server Components → API routes).
# Di Docker Compose, set ke http://app:3000 agar tidak keluar jaringan.
# Kosongkan / hapus saat `next dev` di host — otomatis pakai http://localhost:3000.
# INTERNAL_APP_URL=http://app:3000
NODE_ENV=development

# ================================================================
# Testing (vitest behavior-test harness — see tests/)
# ================================================================
# Test harness menjalankan vitest terhadap database MySQL NYATA (bukan mock),
# terpisah dari database dev. Database test dibuat otomatis jika DB_ROOT_PASSWORD
# tersedia; user aplikasi otomatis di-grant aksesnya.
#
# Override URL database test jika tidak ingin pakai turunan otomatis (<db>_test):
# TEST_DATABASE_URL=mysql://roboedu:password_ubah_disini@127.0.0.1:3306/roboedu_test
#
# Override koneksi admin (CREATE DATABASE / GRANT) jika user di DATABASE_URL
# tidak punya privilege CREATE (mis. root password berbeda):
# TEST_DB_ADMIN_URL=mysql://root:rootpassword_ubah_disini@127.0.0.1:3306
